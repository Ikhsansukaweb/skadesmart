# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# JWT - REQUIRED in production, min 32 chars
# Generate with: openssl rand -base64 32
JWT_SECRET=ganti_dengan_secret_acak_yang_panjang_min_32_karakter
JWT_EXPIRES_IN=2d

# SQLite
DATABASE_PATH=./data/skadesmart.db

# Catbox
CATBOX_USERHASH=isi_userhash_catbox_kamu

# ---------------------------------------------------------------------------
# Notifikasi push (Web Push / VAPID)
# ---------------------------------------------------------------------------
# Menggantikan Firebase Cloud Messaging. Buat kuncinya sekali dengan:
#     npm run vapid
# lalu tempel hasilnya di bawah ini (JANGAN commit nilai aslinya).
# VAPID_PUBLIC_KEY juga perlu ada di frontend sebagai NEXT_PUBLIC_VAPID_KEY?
# Tidak perlu - frontend mengambil kunci publiknya dari server lewat
# GET /api/chats/push/kunci.
VAPID_PUBLIC_KEY=ganti_dengan_kunci_publik_vapid
VAPID_PRIVATE_KEY=ganti_dengan_kunci_privat_vapid
VAPID_SUBJECT=mailto:admin@skadesmart.web.id

# ---------------------------------------------------------------------------
# WebSocket
# ---------------------------------------------------------------------------
# Berapa lama koneksi menganggur sebelum diputus (ms). Ping dari klien setiap
# 25 detik, jadi 60 detik aman.
WS_IDLE_TIMEOUT_MS=60000

# AI CS Bot (OpenAI-compatible endpoint, misal LiteLLM/Ollama gateway lokal)
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=ganti_dengan_api_key_ai_kamu
AI_MODEL=isan
AI_TIMEOUT_MS=45000

# Dummy accounts password (REQUIRED in production, use strong unique passwords per account in real deployment)
# Only used for development seed script
DUMMY_PASSWORD=password_yang_kuat_unik_untuk_dev
